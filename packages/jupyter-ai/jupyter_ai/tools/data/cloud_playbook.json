[
  {
    "id": "api-latency-spike",
    "title": "API latency spike in public gateway",
    "service": "API Gateway",
    "version": 1,
    "lastReviewed": "2025-01-15",
    "severity": "high",
    "taxonomy": {
      "domain": "performance",
      "category": "request-serving",
      "subcategory": "latency"
    },
    "preconditions": [
      "gateway.latency_p95 > 2s for 5 minutes",
      "Public users report HTTP timeouts"
    ],
    "symptoms": [
      "95th percentile latency above 2 seconds",
      "Intermittent client timeouts",
      "Rate limiter near saturation"
    ],
    "diagnostics": [
      {
        "description": "Review request latency dashboard for past 30 minutes"
      },
      {
        "description": "Confirm no recent gateway deployments or config changes"
      },
      {
        "description": "Inspect rate limiter dropped requests metric"
      }
    ],
    "actions": [
      {
        "phase": "mitigation",
        "description": "Temporarily scale gateway replicas by 2x"
      },
      {
        "phase": "mitigation",
        "description": "Invalidate suspect CDN endpoints to refresh cache"
      },
      {
        "phase": "follow-up",
        "description": "Coordinate with platform team to optimize upstream cache configuration"
      }
    ],
    "postChecks": [
      "Monitor gateway.latency_p95 for 15 minutes after scaling",
      "Verify gateway.error_rate remains <1%"
    ],
    "escalation": {
      "condition": "Latency remains above 2s after mitigation",
      "contact": "Platform SRE on-call"
    },
    "metrics": [
      "gateway.latency_p95",
      "gateway.error_rate",
      "rate_limiter.dropped_requests"
    ],
    "notes": [
      "Confirm downstream services are healthy before additional scaling"
    ],
    "references": []
  },
  {
    "id": "database-connection-exhaustion",
    "title": "Database connection exhaustion",
    "service": "Managed PostgreSQL",
    "version": 1,
    "lastReviewed": "2025-01-15",
    "severity": "high",
    "taxonomy": {
      "domain": "availability",
      "category": "data-store",
      "subcategory": "connections"
    },
    "preconditions": [
      "Connection pool usage alert triggered",
      "Application logs show 'too many connections'"
    ],
    "symptoms": [
      "Connection pool remains at 100%",
      "Idle transactions accumulate"
    ],
    "diagnostics": [
      {
        "description": "Inspect pg_stat_activity for long-lived idle sessions"
      },
      {
        "description": "Verify recent deployments did not reduce pool size"
      },
      {
        "description": "Confirm read replicas are healthy"
      }
    ],
    "actions": [
      {
        "phase": "mitigation",
        "description": "Terminate idle sessions older than 10 minutes"
      },
      {
        "phase": "mitigation",
        "description": "Increase application pool limit by 20%"
      },
      {
        "phase": "follow-up",
        "description": "Schedule query tuning review for connection-heavy workloads"
      }
    ],
    "postChecks": [
      "Monitor db.connections_used and app.pool_utilization for 1 hour",
      "Ensure idle transactions trend downward"
    ],
    "escalation": {
      "condition": "Connection saturation returns within 1 hour",
      "contact": "Database vendor support"
    },
    "metrics": [
      "db.connections_used",
      "db.idle_transactions",
      "app.pool_utilization"
    ],
    "notes": [
      "Ensure connection leak alarms are enabled post-incident"
    ],
    "references": []
  },
